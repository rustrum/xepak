# Xepak MCP RAG Testing Justfile
# 
# Override defaults:
#   just server=http://localhost:9090 project=alpha add_note "Test" "Data"

server := env_var_or_default("MCP_SERVER", "http://localhost:8080")
project := env_var_or_default("MCP_PROJECT", "xepak-test-project")


# Runs Xepak server (launches in the separate terminal session)
run:
    cargo run --bin xepak -- ./xepak-rag.toml

# Add knowledge note
add_note title content:
    #!/usr/bin/env sh
    payload=$(jq -n \
      --arg tool "add_note" \
      --arg title {{quote(title)}} \
      --arg content {{quote(content)}} \
      '{jsonrpc: "2.0", id: 1, method: "tools/call", params: {name: $tool, arguments: {title: $title, content: $content}}}')
    
    curl -s -X POST "{{server}}/mcp/rag/{{project}}" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json, text/event-stream" \
      -d "$payload" | jq

# List notes
list_notes limit="42" offset="0":
    #!/usr/bin/env sh
    payload=$(jq -n \
      --arg tool "list_notes" \
      --argjson limit {{limit}} \
      --argjson offset {{offset}} \
      '{jsonrpc: "2.0", id: 1, method: "tools/call", params: {name: $tool, arguments: {limit: $limit, offset: $offset}}}')
    
    curl -s -X POST "{{server}}/mcp/rag/{{project}}" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json, text/event-stream" \
      -d "$payload" | jq

# Get note by id 
