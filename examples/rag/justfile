# Search notes (FTS5)
search_notes query limit="42" offset="0":
    #!/usr/bin/env sh
    payload=$(jq -n \
      --arg tool "search_notes" \
      --arg search_query {{quote(query)}} \
      --argjson limit {{limit}} \
      --argjson offset {{offset}} \
      '{jsonrpc: "2.0", id: 1, method: "tools/call", params: {name: $tool, arguments: {query: $search_query, limit: $limit, offset: $offset}}}')
    
    curl -s -X POST "{{server}}/mcp/rag/{{project}}" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json, text/event-stream" \
      -d "$payload" | jq

# Add action update (previously add_progress)
add_action milestone details="" status="in_progress":
    #!/usr/bin/env sh
    args=$(jq -n \
      --arg milestone {{quote(milestone)}} \
      --arg details {{quote(details)}} \
      --arg status {{quote(status)}} \
      '{milestone: $milestone} + (if $details != "" then {details: $details} else {} end) + (if $status != "" then {status: $status} else {} end)')
    
    payload=$(jq -n \
      --arg tool "add_action" \
      --argjson args "$args" \
      '{jsonrpc: "2.0", id: 1, method: "tools/call", params: {name: $tool, arguments: $args}}')
    
    curl -s -X POST "{{server}}/mcp/rag/{{project}}" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json, text/event-stream" \
      -d "$payload" | jq 

# Update action status
update_action_status id status:
    #!/usr/bin/env sh
    payload=$(jq -n \
      --arg tool "update_action_status" \
      --argjson id {{id}} \
      --arg status {{quote(status)}} \
      '{jsonrpc: "2.0", id: 1, method: "tools/call", params: {name: $tool, arguments: {id: $id, status: $status}}}')
    
    curl -s -X POST "{{server}}/mcp/rag/{{project}}" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json, text/event-stream" \
      -d "$payload" | jq

# List actions (with optional status filter)
list_actions status="" limit="42" offset="0":
    #!/usr/bin/env sh
    payload=$(jq -n \
      --arg tool "list_actions" \
      --arg status {{quote(status)}} \
      --argjson limit {{limit}} \
      --argjson offset {{offset}} \
      '{jsonrpc: "2.0", id: 1, method: "tools/call", params: {name: $tool, arguments: {limit: $limit, offset: $offset} + (if $status != "" then {status: $status} else {} end)}}')

    curl -s -X POST "{{server}}/mcp/rag/{{project}}" \
      -H "Content-Type: application/json" \
      -H "Accept: application/json, text/event-stream" \
      -d "$payload" | jq

