# Xepak simple DSL example
#
# Override the server URL:
#   just server=http://localhost:9090 list_notes

server := env_var_or_default("SIMPLE_API_SERVER", "http://localhost:8080")

# Run the Xepak server with this example.
run:
    cargo run --bin xepak -- ./xepak.toml

# Run server on a particular CPU core using `taskset`
run_on_core core="0":
   taskset -c {{core}}  cargo run --bin xepak -- -l warn ./xepak.toml

# Remove the local example database.
clean:
    #!/usr/bin/env sh
    rm -rf ./db/*
    echo "Cleaned up local database directory."

# Create a note.
add_note title content:
    #!/usr/bin/env sh
    payload=$(jq -n \
      --arg title {{quote(title)}} \
      --arg content {{quote(content)}} \
      '{title: $title, content: $content}')

    curl -sS -X POST "{{server}}/note/add" \
      -H "Content-Type: application/json" \
      -d "$payload" | jq

# Get one note by id.
get_note id:
    @curl -sS "{{server}}/note/{{id}}" | jq

# List notes with pagination.
list_notes limit="50" offset="0":
    @curl -sS "{{server}}/note/list?limit={{limit}}&offset={{offset}}" | jq

# Search notes by keyword in title or content.
search_notes query limit="50" offset="0":
    @curl -sS --get "{{server}}/note/search" \
      --data-urlencode "query={{query}}" \
      --data-urlencode "limit={{limit}}" \
      --data-urlencode "offset={{offset}}" | jq

# Delete a note by id.
delete_note id:
    @curl -sS -X DELETE "{{server}}/note/delete/{{id}}" | jq

# Truncate WAL
wal_truncate:
    @curl -sS "{{server}}/wal/truncate" | jq

# Run load tests for LUA data endpoint
load_test_ldata request_total="10000":
    oha -n {{request_total}} -c 25 --urls-from-file ./oha/lua-data.txt

# Run load tests for LUA add endpoint
load_test_ladd request_total="10000":
    oha -n {{request_total}} -c 25 --urls-from-file ./oha/lua-add.txt

# Run load tests for LUA get note endpoint (require at least 1000 DB records)
load_test_lget request_total="10000":
    oha -n {{request_total}} -c 25 --urls-from-file ./oha/lua-note.txt

# Run load tests for add endpoint
load_test_add request_total="10000":
    oha -n {{request_total}} -c 25 --urls-from-file ./oha/note-add.txt

# Run load tests for simple get endpoint (require at least 1000 DB records)
load_test_get request_total="10000":
    oha -n {{request_total}} -c 25 --urls-from-file ./oha/note-get.txt

