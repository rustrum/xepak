[[endpoint]]
uri = "/script/lua/query/users"
fetch_limit = 20

[endpoint.resource]
type = "query_script_lua"
script = """
local query = query_builder("SELECT * FROM users");

local parts = {};
if ctx:has_arg("name") then
    local v = ctx:get_arg("name")
    if #v < 3 then
        error_input("Input argument 'name' length must be greater than 2")
    end
    table.insert(parts, "username = {{name}}")
end

if ctx:has_arg("pass") then
    table.insert(parts, "password = {{pass}}")
end

query:add_joined_parts("WHERE", parts, "OR", "");

-- query:add("LIMIT {{-limit-}} OFFSET {{-offset-}}");

return query:build();
"""

[[endpoint]]
uri = "/script/lua/query"
fetch_limit = 20

[endpoint.resource]
type = "query_script_lua"
script = """
if ctx:has_arg("etype") then
    local et = ctx:get_arg("etype")
    if et == "in" then
        error_input("Input error from LUA")
    elseif et == "nf" then
        error_not_found("Not found error from LUA")
    elseif et == "fb" then
        error_forbidden("Forbidden error from LUA")
    elseif et == "srv" then
        error_server("Server error from LUA")
    end
end

return "SELECT * FROM users WHERE 1=0";
"""


[[endpoint]]
uri = "/script/lua/subquery"
fetch_limit = 20

[endpoint.resource]
type = "query_script_lua"
script = """
if ctx:has_arg("etype") then
